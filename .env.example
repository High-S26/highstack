# Anthropic API – nie committen. Ohne Key laufen die Agenten im Testmodus.
ANTHROPIC_API_KEY=
# Modelle: Fachexperten und Komitee
HIGHSTACK_MODEL_EXPERT=claude-opus-5-5
HIGHSTACK_MODEL_FAST=claude-sonnet-5-5
# Gleichzeitige Experten im Teamlauf
HIGHSTACK_TEAM_CONCURRENCY=3
# Postgres (optional). Ohne DATABASE_URL speichert die App in .data/store.json
DATABASE_URL=

# Anmeldung: leer = aus (Standard). Zum lokalen Ausprobieren AUTH_SECRET=irgendein-text und ADMIN_EMAIL=ihre@adresse setzen;
# ohne SMTP_URL erscheint der Anmelde-Link dann direkt auf der Anmeldeseite. Online siehe DEPLOY.md
AUTH_SECRET=
ADMIN_EMAIL=
APP_URL=
SMTP_URL=
MAIL_FROM=

# Scalable Capital über die offizielle Scalable CLI (github.com/ScalableCapital/scalable-cli).
# Vorher: CLI installieren, im Scalable-Web unter Profil → Sicherheit → Agentic Investing freischalten, im Terminal `sc login`.
# Nur Admins dieses Servers sehen die Verbindung. Ausführen von Orders zusätzlich nur mit TRADING_LIVE=1, jede Order mit Freigabe per Klick.
SCALABLE_CLI=
# Handel mit echtem Geld (Alpaca live, Scalable-Orders): nur mit 1
TRADING_LIVE=
# Pfad zur CLI, falls `sc` nicht im PATH liegt
SC_BIN=
# Obergrenze je Kauf-Order in Euro (zusätzlich empfohlen: max_order_notional in ~/.config/scalable-cli/config.toml)
SCALABLE_MAX_ORDER=5000

# Lokales Modell über Ollama (z. B. Qwen auf dem eigenen Mac). Auswahl je Experte im Admin unter „KI-Modelle“.
OLLAMA_URL=http://127.0.0.1:11434
