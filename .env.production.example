# Auf dem Server als .env speichern (nie committen). Werte mit <> ersetzen.

# Domain ohne https://
DOMAIN=highstack.si

# Anmeldung: langes Zufallsgeheimnis (z. B. `openssl rand -hex 32`). Ohne AUTH_SECRET gibt es keine Anmeldung!
AUTH_SECRET=<zufallswert>
# Ihre Adresse: wird beim ersten Anmelden Inhaber
ADMIN_EMAIL=<ihre@adresse.de>
# Weitere Plattform-Admins vergeben Sie danach im Admin-Bereich unter Konten.

# Datenbank-Passwort (z. B. `openssl rand -hex 24`)
POSTGRES_PASSWORD=<zufallswert>

# Mailversand für Anmelde-Links (SMTP Ihres Postfachs oder eines Versanddienstes)
# Format: smtps://BENUTZER:PASSWORT@smtp.anbieter.de:465   (Sonderzeichen im Passwort URL-kodieren)
SMTP_URL=<smtp-url>
MAIL_FROM=highstack <no-reply@highstack.si>

# Anthropic API. Ohne Key laufen die Experten im Testmodus.
ANTHROPIC_API_KEY=<sk-ant-...>
HIGHSTACK_MODEL_EXPERT=claude-opus-5-5
HIGHSTACK_MODEL_FAST=claude-sonnet-5-5
HIGHSTACK_TEAM_CONCURRENCY=3

# Trading (Schritt 1): Simulation braucht nichts. Alpaca-Paper-Schlüssel trägt man im Agenten ein (verschlüsselt gespeichert);
# optional serverweit als Vorgabe für eigene Nutzung:
# ALPACA_KEY_ID=
# ALPACA_SECRET=
# Schlüssel für die Verschlüsselung der Broker-Zugänge (sonst aus AUTH_SECRET abgeleitet)
# TRADING_SECRET=
# Echtgeld-Handel bleibt aus, bis hier 1 steht
TRADING_LIVE=0
# Dauerlauf der Agenten im App-Prozess (0 = aus). Nur eine App-Instanz betreiben, sonst handeln Agenten doppelt.
TRADING_DAUERLAUF=1
# Konjunkturdaten: kostenloser Schlüssel von fred.stlouisfed.org (Zinsen, VIX, S&P 500, Inflation, Arbeitsmarkt).
# Ohne Schlüssel nutzt highstack den öffentlichen CSV-Export von FRED. Abruf alle 12 Stunden im Dauerlauf (KONJUNKTUR_ABRUF=0 schaltet ab).
# FRED_API_KEY=
